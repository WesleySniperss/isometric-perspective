<section class="tab scrollable isometric-tab-content {{tab.cssClass}}"data-tab="isometric" data-group="sheet">
  {{!-- Tab content here --}}
  <div class="isometric-config-tab-content">
    <section>
        <!-- Enable Isometric -->
        <div class="form-group">
            <label for="{{rootId}}-isometric-perspective-enable-isometrics">{{localize 'isometric-perspective.scene_enableIsometric'}}</label>
            <input id="{{rootId}}-isometric-perspective-enable-isometrics" type="checkbox" name="flags.isometric-perspective.isometricEnabled" {{checked document.flags.isometric-perspective.isometricEnabled}}/>
        </div>
        
        <!-- Transform Background -->
        <div class="form-group">
            <label for="{{rootId}}-isometric-perspective-isometrics-background-transfrom" >{{localize 'isometric-perspective.scene_transform_name'}}</label>
            <input id="{{rootId}}-isometric-perspective-isometrics-background-transfrom" type="checkbox" name="flags.isometric-perspective.isometricBackground" {{checked document.flags.isometric-perspective.isometricBackground}}/>
        </div>
        <p class="hint">{{localize 'isometric-perspective.scene_transform_hint'}}</p>

        <hr>

        <!-- Scale Control -->
        <div class="form-group">
            <label for="isometric-perspective-isometrics-scale" >{{localize 'isometric-perspective.scene_scale_name'}}</label>
            <div class="form-fields">
                <range-picker id="{{rootId}}-isometric-perspective-isometrics-scale" name="flags.isometric-perspective.isometricScale" value="{{document.flags.isometric-perspective.isometricScale}}" min="0.5" max="3" step="0.01"></range-picker>
            </div>
            <p class="hint">{{localize 'isometric-perspective.scene_scale_hint_1'}} <i class="fas fa-ruler"></i> {{localize 'isometric-perspective.scene_scale_hint_2'}}</p>
        </div>
    </section>

    <!-- Projection Type Dropdown -->
    <div class="form-group">
        <label>{{localize 'isometric-perspective.scene_dropdown_name'}}</label>
        <div class="form-fields">
        <select id="{{rootId}}-isometric-perspective-projection-type" name="flags.isometric-perspective.projectionType">
            {{#each projectionTypes}}
                <option value="{{this}}" {{#if (eq this ../document.flags.isometric-perspective.projectionType)}}selected{{/if}}>{{this}}</option>
            {{/each}}
            </select>
        </div>
        <p class="hint">{{localize 'isometric-perspective.scene_dropdown_hint'}}</p>          
    </div>

    <div class="form-group custom-projection-container hidden">
        <label>{{localize 'isometric-perspective.custom_projection_name'}}</label>
        <div class="form-fields">
            <input
                type="text" 
                name="flags.isometric-perspective.customProjection" 
                placeholder="0, 0, 0, 0, 0, 0, 0" 
                disabled
            >
        </div>
        <p class="hint">{{localize 'isometric-perspective.custom_projection_hint'}}  <a href='https://github.com/arlosmolten/isometric-perspective/wiki/2.-Advanced-Features#2-custom-isometric-projection'>Manual</a> &  <a href='https://arlosmolten.github.io/isometric-perspective/'>Website</a></p>
    </div>

    <!-- Vanishing Point Perspective -->
    <div class="perspective-container hidden">
        <p class="hint">{{localize 'isometric-perspective.scene_perspective_intro'}}</p>
        <p class="notification warning perspective-save-notice hidden"><i class="fa-solid fa-floppy-disk"></i> {{localize 'isometric-perspective.scene_perspective_save_notice'}}</p>

        <div class="form-group">
            <label for="{{rootId}}-isometric-perspective-perspective-tilt">{{localize 'isometric-perspective.scene_perspective_tilt_name'}}</label>
            <div class="form-fields">
                <range-picker id="{{rootId}}-isometric-perspective-perspective-tilt" name="flags.isometric-perspective.perspectiveTilt" value="{{document.flags.isometric-perspective.perspectiveTilt}}" min="0" max="85" step="1"></range-picker>
            </div>
            <p class="hint">{{localize 'isometric-perspective.scene_perspective_tilt_hint'}}</p>
        </div>

        <div class="form-group">
            <label for="{{rootId}}-isometric-perspective-perspective-rotation">{{localize 'isometric-perspective.scene_perspective_rotation_name'}}</label>
            <div class="form-fields">
                <range-picker id="{{rootId}}-isometric-perspective-perspective-rotation" name="flags.isometric-perspective.perspectiveRotation" value="{{document.flags.isometric-perspective.perspectiveRotation}}" min="-180" max="180" step="1"></range-picker>
            </div>
            <p class="hint">{{localize 'isometric-perspective.scene_perspective_rotation_hint'}}</p>
        </div>

        <div class="form-group">
            <label for="{{rootId}}-isometric-perspective-perspective-fov">{{localize 'isometric-perspective.scene_perspective_fov_name'}}</label>
            <div class="form-fields">
                <range-picker id="{{rootId}}-isometric-perspective-perspective-fov" name="flags.isometric-perspective.perspectiveFov" value="{{document.flags.isometric-perspective.perspectiveFov}}" min="0" max="150" step="1"></range-picker>
            </div>
            <p class="hint">{{localize 'isometric-perspective.scene_perspective_fov_hint'}}</p>
        </div>

        <div class="form-group">
            <label for="{{rootId}}-isometric-perspective-perspective-scale">{{localize 'isometric-perspective.scene_perspective_scale_name'}}</label>
            <div class="form-fields">
                <range-picker id="{{rootId}}-isometric-perspective-perspective-scale" name="flags.isometric-perspective.perspectiveScale" value="{{document.flags.isometric-perspective.perspectiveScale}}" min="0.1" max="4" step="0.01"></range-picker>
            </div>
            <p class="hint">{{localize 'isometric-perspective.scene_perspective_scale_hint'}}</p>
        </div>

        <div class="form-group offset-point">
            <label>{{localize 'isometric-perspective.scene_perspective_position_name'}}</label>
            <div class="form-fields">
                <label class="axisX">X</label>
                <input type="number" name="flags.isometric-perspective.perspectiveOffsetX" value="{{document.flags.isometric-perspective.perspectiveOffsetX}}" placeholder="0" step="1"/>
                <button type="button" class="fine-adjust perspective-fine-adjust" title="{{localize 'isometric-perspective.scene_perspective_position_mouseover'}}">✥</button>
                <input type="number" name="flags.isometric-perspective.perspectiveOffsetY" value="{{document.flags.isometric-perspective.perspectiveOffsetY}}" placeholder="0" step="1"/>
                <label class="axisY">Y</label>
            </div>
            <p class="hint">{{localize 'isometric-perspective.scene_perspective_position_hint'}}</p>
        </div>

        <div class="form-group offset-point">
            <label>{{localize 'isometric-perspective.scene_perspective_cells_name'}}</label>
            <div class="form-fields">
                <input type="number" name="flags.isometric-perspective.perspectiveColumns" value="{{document.flags.isometric-perspective.perspectiveColumns}}" min="1" max="500" step="1"/>
                <label>×</label>
                <input type="number" name="flags.isometric-perspective.perspectiveRows" value="{{document.flags.isometric-perspective.perspectiveRows}}" min="1" max="500" step="1"/>
            </div>
            <p class="hint">{{localize 'isometric-perspective.scene_perspective_cells_hint'}}</p>
        </div>

        <div class="form-group">
            <label for="{{rootId}}-isometric-perspective-perspective-grid-color">{{localize 'isometric-perspective.scene_perspective_grid_color_name'}}</label>
            <div class="form-fields">
                <color-picker id="{{rootId}}-isometric-perspective-perspective-grid-color" name="flags.isometric-perspective.perspectiveGridColor" value="{{document.flags.isometric-perspective.perspectiveGridColor}}"></color-picker>
            </div>
        </div>

        <div class="form-group">
            <label for="{{rootId}}-isometric-perspective-perspective-grid-alpha">{{localize 'isometric-perspective.scene_perspective_grid_alpha_name'}}</label>
            <div class="form-fields">
                <range-picker id="{{rootId}}-isometric-perspective-perspective-grid-alpha" name="flags.isometric-perspective.perspectiveGridAlpha" value="{{document.flags.isometric-perspective.perspectiveGridAlpha}}" min="0" max="1" step="0.05"></range-picker>
            </div>
        </div>

        <div class="form-group">
            <label for="{{rootId}}-isometric-perspective-perspective-grid-thickness">{{localize 'isometric-perspective.scene_perspective_grid_thickness_name'}}</label>
            <div class="form-fields">
                <range-picker id="{{rootId}}-isometric-perspective-perspective-grid-thickness" name="flags.isometric-perspective.perspectiveGridThickness" value="{{document.flags.isometric-perspective.perspectiveGridThickness}}" min="0.5" max="10" step="0.5"></range-picker>
            </div>
            <p class="hint">{{localize 'isometric-perspective.scene_perspective_grid_style_hint'}}</p>
        </div>

        <div class="form-group">
            <label for="{{rootId}}-isometric-perspective-perspective-standing">{{localize 'isometric-perspective.scene_perspective_standing_name'}}</label>
            <div class="form-fields">
                <select id="{{rootId}}-isometric-perspective-perspective-standing" name="flags.isometric-perspective.perspectiveStandingTokens">
                    {{selectOptions perspectiveStandingChoices selected=perspectiveStandingTokens}}
                </select>
            </div>
        </div>
        <p class="hint">{{localize 'isometric-perspective.scene_perspective_standing_hint'}}</p>
    </div>
  </div>
</section>