<!-- Isometric Token Configuration.html -->
<section class="tab scrollable {{tab.cssClass}}"data-tab="isometric" data-group="sheet">

    <div class="form-group">
        <label for="{{rootId}}-isometric-perspective-enable-token-isometrics">{{localize 'isometric-perspective.token_enableIsometric_name'}}</label>
        <input id="{{rootId}}-isometric-perspective-enable-token-isometrics" type="checkbox" name="flags.isometric-perspective.isoTokenDisabled" {{checked document.flags.isometric-perspective.isoTokenDisabled}}>
    </div>
    <p class="hint">{{localize 'isometric-perspective.token_enableIsometric_hint'}}</p>

    <div class="form-group">
        <label for="{{rootId}}-isometric-perspective-perspective-pose">{{localize 'isometric-perspective.token_perspectivePose_name'}}</label>
        <div class="form-fields">
            <select id="{{rootId}}-isometric-perspective-perspective-pose" name="flags.isometric-perspective.perspectivePose">
                <option value="default">{{localize 'isometric-perspective.token_perspectivePose_default'}}</option>
                <option value="standing" {{#if (eq document.flags.isometric-perspective.perspectivePose "standing")}}selected{{/if}}>{{localize 'isometric-perspective.token_perspectivePose_standing'}}</option>
                <option value="flat" {{#if (eq document.flags.isometric-perspective.perspectivePose "flat")}}selected{{/if}}>{{localize 'isometric-perspective.token_perspectivePose_flat'}}</option>
            </select>
        </div>
    </div>
    <p class="hint">{{localize 'isometric-perspective.token_perspectivePose_hint'}}</p>
    <div class="form-group">
        <label for="{{rootId}}-isometric-perspective-standing-art">{{localize 'isometric-perspective.token_standingArt_name'}}</label>
        <div class="form-fields">
            <select id="{{rootId}}-isometric-perspective-standing-art" name="flags.isometric-perspective.perspectiveStandingArt">
                <option value="default">{{localize 'isometric-perspective.token_standingArt_default'}}</option>
                <option value="image" {{#if (eq document.flags.isometric-perspective.perspectiveStandingArt "image")}}selected{{/if}}>{{localize 'isometric-perspective.token_standingArt_image'}}</option>
                <option value="portrait" {{#if (eq document.flags.isometric-perspective.perspectiveStandingArt "portrait")}}selected{{/if}}>{{localize 'isometric-perspective.standing_art_portrait'}}</option>
                <option value="token" {{#if (eq document.flags.isometric-perspective.perspectiveStandingArt "token")}}selected{{/if}}>{{localize 'isometric-perspective.standing_art_token'}}</option>
            </select>
        </div>
    </div>
    <p class="hint">{{localize 'isometric-perspective.token_standingArt_hint'}}</p>

    <div class="form-group">
        <label>{{localize 'isometric-perspective.token_standingImage_name'}}</label>
        <div class="form-fields">
            <file-picker name="flags.isometric-perspective.perspectiveStandingImage" type="imagevideo" value="{{document.flags.isometric-perspective.perspectiveStandingImage}}"></file-picker>
        </div>
    </div>
    <div class="form-group">
        <label>{{localize 'isometric-perspective.token_standingHeight_name'}}</label>
        <div class="form-fields">
            <input type="number" name="flags.isometric-perspective.perspectiveStandingHeight" value="{{document.flags.isometric-perspective.perspectiveStandingHeight}}" min="0.25" max="4" step="0.1">
        </div>
    </div>
    <p class="hint">{{localize 'isometric-perspective.token_standingImage_hint'}}</p>
    <div class="form-group offset-point">
        <label>{{localize 'isometric-perspective.token_artOffset_name'}}</label>
        <div class="form-fields">
            <label class="axisX">X</label>
            <input 
                type="number" 
                name="flags.isometric-perspective.offsetX" 
                value="{{offsetX}}"
                step="1"
            />
            <button class="fine-adjust" title="Hold and drag to fine-tune X and Y">✥</button>
            <input 
                type="number" 
                name="flags.isometric-perspective.offsetY"
                value="{{offsetY}}"
                step="1" 
            />
            <label class="axisY">Y</label>
        </div>
    </div>
    <p class="hint">{{localize 'isometric-perspective.token_artOffset_hint'}}</p>

    <div class="form-group anchor-point">
        <label>{{localize 'isometric-perspective.token_isoAnchor_name'}}</label>
        <div class="form-fields">
            <label class="anchorToggle">{{localize 'isometric-perspective.token_isoAnchor_save'}}</label>
            <input type="checkbox" class="anchor-toggle-checkbox" name="isoAnchorToggle" {{checked document.flags.isometric-perspective.isoAnchorToggle}}>
            <label class="axisX">X</label>
            <input type="number" name="flags.isometric-perspective.isoAnchorY" 
                    value="{{isoAnchorY}}"
                    step="0.01" />
            <button class="fine-adjust-anchor" title="Hold and drag to fine-tune X and Y">✥</button>
            <input type="number" name="flags.isometric-perspective.isoAnchorX"
                    value="{{isoAnchorX}}"
                    step="0.01" />
            <label class="axisY">Y</label>
        </div>
    </div>
    <p class="hint">{{localize 'isometric-perspective.token_isoAnchor_hint'}}</p>

    <button class="toggle-alignment-lines" title="{{localize 'isometric-perspective.token_resetAlignmentButton_mouseover'}}">
        {{localize 'isometric-perspective.token_resetAlignmentButton_name'}}
    </button>

    <div class="form-group">
        <label>{{localize 'isometric-perspective.token_scale_name'}}</label>
        <div class="form-fields">
            <range-picker id="{{rootId}}-flags.isometric-perspective.scale" name="flags.isometric-perspective.scale" value="{{document.flags.isometric-perspective.scale}}" min="0.1" max="3" step="0.01"></range-picker>
        </div>
        <p class="hint">{{localize 'isometric-perspective.token_scale_hint'}}</p>
    </div>

    <div class="form-group">
        <label style="flex: 3;">{{localize 'isometric-perspective.token_disableScale_name'}}</label>
        <div class="form-fields">
            <input type="checkbox" name="flags.isometric-perspective.isoScaleDisabled" {{checked document.flags.isometric-perspective.isoScaleDisabled}}>
        </div>
        <p class="hint">{{localize 'isometric-perspective.token_disableScale_hint'}}</p>
    </div>

</section>